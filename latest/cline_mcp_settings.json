{
  "mcpServers": {
    "irods": {
      "timeout": 60,
      "type": "streamableHttp",
      "url": "https://mcp-public.cyverse.ai/mcp"
    },
    "mesa": {
      "timeout": 60,
      "type": "stdio",
      "command": "/usr/local/bin/mesa-mcp",
      "args": [],
      "env": {
        "MESA_MCP_IRODS__HOST": "data.cyverse.org",
        "MESA_MCP_IRODS__PORT": "1247",
        "MESA_MCP_IRODS__ZONE": "iplant"
      }
    },
    "formation": {
      "timeout": 60,
      "type": "streamableHttp",
      "url": "https://de.cyverse.org/formation/mcp"
    },
    "filesystem": {
      "timeout": 60,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/config",
        "/home/vscode/data-store"
      ]
    }
  }
}
